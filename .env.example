# Every setting here is optional. The app runs local-first with no configuration at all: the
# database, the scraper and the enrichment worker all work out of the box.

# Chromium runs headless by default. Set to false to watch the browser during a scrape, which is
# also the first thing to try when Google throttles a run. There is also a runtime toggle on the
# Maps page (Run behaviour → Show the browser window) that overrides this.
VITE_SCRAPER_HEADLESS=true

# The deep pass ("Deep Enrich" on the Decision Makers page) searches Google, through DataForSEO, for
# the decision makers a lead's own site does not name. It is a paid service and needs an account.
#
# The key is normally entered in the app itself — Settings → Account → DataForSEO key — where it is
# kept on this machine and never committed anywhere. This variable is here for a scripted or shared
# machine that would rather supply it from the environment; the app reads the Settings value first.
#
# Do not commit a key. It is a Base64-encoded `login:password` pair, which is a credential and not
# encryption, and one that has been pasted into a chat, a ticket or a log should be rotated in the
# DataForSEO dashboard rather than reused.
# DATAFORSEO_API_KEY=
# Or point at a file supplied by the host/secret manager. The file may contain KEY=...,
# DATAFORSEO_API_KEY=..., or the credential alone. The file itself stays outside the app bundle.
# DATAFORSEO_API_KEY_FILE=

# Nafran Assist uses Cerebras' OpenAI-compatible chat-completions endpoint. The key is read only by
# Electron's main process; it is never placed in VITE_* or bundled into the renderer.
# CEREBRAS_API_KEY=
# Or use a secret file outside the project:
# CEREBRAS_API_KEY_FILE=
# CEREBRAS_API_URL=https://api.cerebras.ai/v1
# CEREBRAS_MODEL=gpt-oss-120b
# The NAFRAN_ASSIST_* and OPENAI_* names remain supported for custom OpenAI-compatible endpoints.

# Email Finder validity checks prefer an Apify Actor and send every visible address in one batch.
# The token is read by Electron's main process only. The default desktop location is
# userData/secrets/apify.key; servers and scripted runs may provide either variable below instead.
# APIFY_API_TOKEN=
# APIFY_API_TOKEN_FILE=
# APIFY_EMAIL_VERIFIER_ACTOR=apivault_labs/email-deliverability-checker

# MailVerifier remains supported as a fallback on machines without an Apify token.
# Its default desktop location is userData/secrets/mailverifier.key.
# MAILVERIFIER_API_KEY=
# MAILVERIFIER_API_KEY_FILE=

# Release signing is configured in CI rather than committed here.
# REQUIRE_CODE_SIGNING=1
# WIN_CSC_LINK=
# WIN_CSC_KEY_PASSWORD=
# CSC_LINK=
# CSC_KEY_PASSWORD=
# REQUIRE_NOTARIZATION=1
# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD=
# APPLE_TEAM_ID=
# APPLE_API_KEY=                 # path to a .p8 key for local builds
# APPLE_API_KEY_P8=              # raw .p8 contents for the GitHub Actions secret
# APPLE_API_KEY_ID=
# APPLE_API_ISSUER=
# REQUIRE_LINUX_SIGNING=1
# LINUX_GPG_PRIVATE_KEY=
# LINUX_GPG_PASSPHRASE=
# LINUX_GPG_KEY_ID=

# Packaged apps read update metadata and installers from this HTTPS directory. Supply the same
# URL when building every platform's release; CI requires it for signed release jobs.
# LEADSNAP_UPDATE_URL=https://your-domain.example/updates/nafran/
# REQUIRE_UPDATE_FEED=1

# Stripe billing runs in a separate server. Never put STRIPE_SECRET_KEY or a restricted key in the
# Electron renderer, installer, or a VITE_* variable. Source builds can override the billing API
# locally for testing; packaged builds use https://mamalead.com.
# LEADSNAP_BILLING_API_URL=http://127.0.0.1:38747
# Server-only variables (set on the HTTPS host, or use .secrets/stripe-test.env for local testing):
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_LIFETIME=
# BILLING_PUBLIC_URL=https://your-billing-domain.example
# APP_PUBLIC_URL=https://mamalead.com
# RESEND_API_KEY=
# EMAIL_FROM=licenses@mamalead.com
# STRIPE_WEBHOOK_SECRET=
# DOWNLOAD_SIGNING_KEY=
# BLOB_DOWNLOAD_PATH=
# LOCAL_DOWNLOAD_PATH=/srv/mamalead/installers/Nafran-Leads-Scraper-Setup.exe
# MAC_ARM64_LOCAL_DOWNLOAD_PATH=/srv/mamalead/installers/Nafran-Leads-Scraper-Apple-Silicon.dmg
# MAC_X64_LOCAL_DOWNLOAD_PATH=/srv/mamalead/installers/Nafran-Leads-Scraper-Intel.dmg
# MAC_ARM64_BLOB_DOWNLOAD_PATH=
# MAC_X64_BLOB_DOWNLOAD_PATH=
# BILLING_HOST=127.0.0.1
# BILLING_PORT=38747
# BILLING_DB_PATH=/var/lib/mamalead/billing.db
# Vercel billing project uses Neon Postgres instead of BILLING_DB_PATH:
# DATABASE_URL=postgresql://...
